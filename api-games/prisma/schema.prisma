generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  description        String   @default("")
  coverUrl           String   @default("")
  iconEmoji          String   @default("🎮")
  isActive           Boolean  @default(false)
  maxLevels          Int      @default(30)
  coinsPerLevelBase  Int      @default(5)
  coinsPerLevelStep  Int      @default(2)
  bonusCoins         Int      @default(4)
  continueCost       Int      @default(2)
  createdAt          DateTime @default(now())

  levels         Level[]
  sessions       GameSession[]
  profiles       PlayerProfile[]
  leaderboards   LeaderboardEntry[]
  achievements   Achievement[]
}

model Level {
  id             String  @id @default(uuid())
  gameId         String
  number         Int
  speedMult      Float   @default(1.0)
  fireRateMult   Float   @default(1.0)
  enemyColsCount Int     @default(8)
  enemyRowsCount Int     @default(4)
  bunkerCount    Int     @default(4)
  hasMysteryTank Boolean @default(false)
  specialEvent   String  @default("none")
  isBoss         Boolean @default(false)
  bossHits       Int     @default(1)
  enemyMixLight  Int     @default(60)
  enemyMixMedium Int     @default(30)
  enemyMixHeavy  Int     @default(10)

  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions GameSession[]

  @@unique([gameId, number])
}

model PlayerProfile {
  id               String   @id @default(uuid())
  studentId        String
  gameId           String
  currentLevel     Int      @default(1)
  maxLevelReached  Int      @default(1)
  totalCoinsEarned Int      @default(0)
  totalSessions    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions GameSession[]

  @@unique([studentId, gameId])
}

model GameSession {
  id             String    @id @default(uuid())
  studentId      String
  gameId         String
  levelId        String
  profileId      String
  score          Int       @default(0)
  coinsEarned    Int       @default(0)
  continueCount  Int       @default(0)
  completed      Boolean   @default(false)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSec    Int?
  idempotencyKey String?   @unique

  game    Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  level   Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  events  SessionEvent[]
}

model SessionEvent {
  id         String   @id @default(uuid())
  sessionId  String
  type       String
  payload    String   @default("{}")
  occurredAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LeaderboardEntry {
  id        String   @id @default(uuid())
  gameId    String
  studentId String
  courseId  String
  weekStart DateTime
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, studentId, weekStart])
}

model Achievement {
  id          String @id @default(uuid())
  gameId      String
  slug        String
  title       String
  description String @default("")
  iconEmoji   String @default("🏆")
  condition   String

  game    Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  players PlayerAchievement[]

  @@unique([gameId, slug])
}

model PlayerAchievement {
  id            String   @id @default(uuid())
  studentId     String
  achievementId String
  earnedAt      DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
}
